# Copy to project root as .env when using Docker Compose for Postgres.
# For go run on the host: PG_HOST=localhost and PG_PORT must match POSTGRES_HOST_PORT.

# === Docker Compose (postgres + pgadmin) ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myapp_db
POSTGRES_HOST_PORT=5433

PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_HOST_PORT=5050

# === App (host: go run cmd/service/main.go) ===
APP_HTTP_PORT=8090
APP_GRPC_PORT=8091
ENVIRONMENT=development
# In development registration is not required for /v1/generate/text (set false to enforce)
# DEV_SKIP_REGISTRATION=true
LOG_LEVEL=debug

PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=postgres
PG_DBNAME=myapp_db
PG_SSLMODE=disable

# === YandexGPT (default model: yandexgpt) — works in Russia ===
# https://yandex.cloud/ → Foundation Models → API key + folder id
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt/latest

# === Gemini (model slug: gemini-flash) ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_BASE_URL=

# === OpenAI (model slug: openai) ===
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_API_BASE_URL=

# === OpenAI (optional; other categories) ===
OPENAI_API_KEY=
OPENAI_API_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# === pgAdmin in browser (http://localhost:5050) ===
# Login: PGADMIN_DEFAULT_EMAIL / PGADMIN_DEFAULT_PASSWORD
# Server "tgapp (docker)" is preconfigured — Host must be "postgres", port 5432 (Docker network).
#
# Desktop pgAdmin / DBeaver on Windows (outside Docker):
#   Host: localhost
#   Port: 5433   <-- NOT 5432 (that is often a different local PostgreSQL install)
#   User: postgres
#   Password: postgres
#   Database: myapp_db
